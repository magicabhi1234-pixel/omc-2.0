# Supabase - the single content source for the whole site: CMS data
# (landing pages, blog posts, universities, testimonials, media, nav, settings),
# admin auth/sessions, and lead persistence.
# Project URL and anon key are public/safe to expose (NEXT_PUBLIC_ prefixed) -
# get all three from Supabase Dashboard > Settings > API.
# Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only delivery. RESEND_FROM_EMAIL must be a sender verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Sanity CMS - LEGACY, one-time use only. Needed only to run
# `npm run migrate:cms` (scripts/migrate-sanity-to-supabase.mjs), which reads
# the old Sanity content one last time and writes it into Supabase. Not read
# by the live site or the admin dashboard - safe to remove once migration is done.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SANITY_USE_CDN=false
SANITY_API_TOKEN=

# Server-only. Shared secret checked by app/api/revalidate - pass it as that
# route's ?secret= query param when triggering a manual cache revalidation.
REVALIDATE_SECRET=
