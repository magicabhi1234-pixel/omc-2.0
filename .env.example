# Server-only lead persistence. Use the Project URL and service-role key from
# Supabase Dashboard > Settings > API. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only delivery. RESEND_FROM_EMAIL must be a sender verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Sanity CMS - required for landing pages, blog posts, universities and
# testimonials to render. Get these from https://www.sanity.io/manage
# (Project ID/dataset are public and safe to expose - NEXT_PUBLIC_ prefixed).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SANITY_USE_CDN=false

# Server-only. Only needed for write operations (migration scripts) - the
# live site only ever reads from Sanity. Editor or Administrator permission,
# generated at https://www.sanity.io/manage/project/<project-id>/api.
SANITY_API_TOKEN=

# Server-only. Shared secret checked by app/api/send-email/revalidate - set
# this as the Sanity Studio webhook's query param (?secret=...) too.
REVALIDATE_SECRET=
