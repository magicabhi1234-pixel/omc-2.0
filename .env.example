# Supabase - the single content source for the whole site: CMS data
# (landing pages, blog posts, universities, testimonials, media, nav, settings),
# admin auth/sessions, and lead persistence.
# Project URL and anon key are public/safe to expose (NEXT_PUBLIC_ prefixed) -
# get all three from Supabase Dashboard > Settings > API.
# Never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only delivery. RESEND_FROM_EMAIL must be a sender verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Sanity - read-only FALLBACK + IMPORT SOURCE (hybrid CMS). The dashboard
# (Supabase) is primary; the site reads published Sanity content only when
# Supabase is unreachable or a page never existed in the dashboard, and
# /admin/sync + /api/sanity-sync import new Sanity documents (insert-only).
# SANITY_API_TOKEN (server-only, Viewer role is enough) is needed only for a
# private dataset. Also used by `npm run migrate:cms`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
# Shared secret for the Sanity webhook -> POST /api/sanity-sync, sent as
# "Authorization: Bearer <secret>". Generate with: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=

# Server-only. Shared secret checked by app/api/revalidate - send it as
# "Authorization: Bearer <secret>" (or the legacy ?secret= query param).
REVALIDATE_SECRET=
